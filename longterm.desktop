[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=longterm
Exec=/usr/bin/longterm
Name=Longterm
X-Share-Methods=upload;

[X-Sailjail]
OrganizationName=rs.r8
ApplicationName=longterm
Permissions=Internet;Secrets;UserDirs

[X-Share Method upload]
Description=Upload to a server
Capabilities=*/*
SupportsMultipleFiles=yes
